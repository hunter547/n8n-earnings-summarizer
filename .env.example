# Postgres (n8n state + dedup table)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=n8n

# n8n basic auth (UI login)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_strong_password

# n8n host config (leave defaults for local)
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# Data sources (all free tiers)
FINNHUB_API_KEY=               # https://finnhub.io/register
FRED_API_KEY=                  # https://fred.stlouisfed.org/docs/api/api_key.html
EIA_API_KEY=                   # https://www.eia.gov/opendata/register.php
MARKETAUX_API_KEY=             # https://www.marketaux.com/account/dashboard
FMP_API_KEY=                   # https://site.financialmodelingprep.com/developer/docs  (free: 250 req/day)

# Anthropic (summarization — Claude Sonnet 4.6)
ANTHROPIC_API_KEY=             # https://console.anthropic.com/settings/keys

# Telegram delivery
# 1) DM @BotFather, /newbot, copy token below
# 2) Send any message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Copy the "chat":{"id":...} value
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
